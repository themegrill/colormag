# Copy this file to `.env.local` in the THEME ROOT (next to package.json) and
# fill in real values. `.env.local` is gitignored — never commit credentials.
#
# You do not need any of this to run against http://test-colormag.local with
# the defaults; you need it to point the suite somewhere else, and you need the
# WP_DB_* block for any run against a real (non-disposable) site.
#
# Precedence, highest first — see tests/e2e/env.ts:
#   TGQA_*  exported by themegrill-qa's run-suite.mjs; you never set these
#   CM_*    your own overrides, below
#   WP_*    what this suite read before the platform existed; still honoured

CM_BASE_URL=http://test-colormag.local
CM_ADMIN_USER=
CM_ADMIN_PASS=

# ---------------------------------------------------------------------------
# Database — only for `local` runs (TGQA_ENV unset or `local`).
#
# Two things need it, and both are skipped automatically on Playground, which
# is PHP-WASM on SQLite with no MySQL at all:
#
#   1. global-setup.ts trashes stale `auto-draft` customize_changeset rows, so
#      a run cannot silently inherit a leftover autosave from a crashed one.
#   2. theme-mods-snapshot.ts captures the ACTIVE theme's mods before the run
#      and restores them after every customizer spec and once at the end.
#
# `customize_changeset` is not REST-exposed and theme mods are a serialized
# blob, so both talk to MySQL directly rather than through WordPress.
# ---------------------------------------------------------------------------

# Connect over TCP...
WP_DB_HOST=
WP_DB_PORT=3306

# ...or over a unix socket, which WINS over host/port when both are set.
# Local by Flywheel on macOS needs this: its MySQL listens on a port but
# answers 127.0.0.1 with "Host is not allowed to connect to this MySQL
# server", while accepting the same credentials over its socket. Find it at
#   ~/Library/Application Support/Local/run/<site-id>/mysql/mysqld.sock
# Note this is NOT wp-config's `localhost:/path` form — the mysql CLI does not
# understand that, which is why it gets its own variable.
WP_DB_SOCKET=

WP_DB_USER=
WP_DB_PASSWORD=
WP_DB_NAME=
WP_DB_TABLE_PREFIX=wp_

# Only needed if `mysql` is not on PATH. Local by Flywheel bundles one:
#   macOS   ~/Library/Application Support/Local/lightning-services/mysql-<ver>/bin/darwin-arm64/bin/mysql
#   Windows %APPDATA%/Local/lightning-services/mysql-<ver>/bin/win64/bin/mysql.exe
WP_DB_MYSQL_BIN=
