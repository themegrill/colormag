# Copy this file to tests/e2e/.env and fill in real values.
# tests/e2e/.env is gitignored — never commit real credentials.

WP_BASE_URL=http://test-colormag.local
WP_ADMIN_USER=
WP_ADMIN_PASSWORD=

# Required so global-setup.ts can trash stale Customizer auto-draft
# changesets before the suite runs (see clearStaleChangesets() in that file
# for why this is a hard precondition, not optional). WP-CLI isn't assumed
# available, so this connects directly with the `mysql` client.
WP_DB_HOST=
WP_DB_PORT=3306
WP_DB_USER=
WP_DB_PASSWORD=
WP_DB_NAME=
WP_DB_TABLE_PREFIX=wp_
# Only needed if `mysql` isn't on PATH — e.g. a Local by Flywheel bundled
# client: .../Local/lightning-services/mysql-<version>/bin/win64/bin/mysql.exe
WP_DB_MYSQL_BIN=
